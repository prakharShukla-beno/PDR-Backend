PORT=5000

NODE_ENV=development



# Required — MongoDB connection string

MONGO_URI=



# Required — auth

JWT_SECRET=

JWT_REFRESH_SECRET=

JWT_EXPIRES_IN=7d



# Email — Resend (invite + password reset)

RESEND_API_KEY=

EMAIL_FROM_NAME=Beno PDR

EMAIL_FROM_ADDRESS=onboarding@resend.dev

# Change to noreply@benosupport.com once domain is verified



FRONTEND_URL=http://localhost:3000



# AI Provider — OpenAI takes priority if both keys are present

OPENAI_API_KEY=        # optional — uses gpt-4o-mini

GEMINI_API_KEY=        # fallback if OPENAI_API_KEY is not set

